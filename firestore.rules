rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    // Username-to-UID mapping is private. Only the account owner can create
    // their mapping; clients cannot read, overwrite, or delete mappings.
    // The callable loginWithUsername function accesses mappings with Admin SDK.
    match /usernames/{username} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }
  }
}
